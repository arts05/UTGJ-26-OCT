[gd_scene format=3]

[ext_resource type="PackedScene" path="res://assets/models/aken-rodu.glb" id="1_model"]
[ext_resource type="Texture2D" path="res://assets/models/aken-rodu_Balcony Base Color.png" id="2_balcony_texture"]
[ext_resource type="Texture2D" path="res://assets/models/aken-rodu_WindowFrame Base Color.png" id="3_frame_texture"]
[ext_resource type="Texture2D" path="res://assets/models/aken-rodu_WindowPane Base Color.png" id="4_glass_texture"]
[ext_resource type="Script" path="res://scripts/balcony_weather.gd" id="5_weather"]
[ext_resource type="Shader" path="res://shaders/winter_sky.gdshader" id="6_sky"]
[ext_resource type="Shader" path="res://shaders/drifting_fog.gdshader" id="7_fog"]
[ext_resource type="Shader" path="res://shaders/snowflake.gdshader" id="8_snow"]
[ext_resource type="PackedScene" path="res://scenes/neighbour_building.tscn" id="9_building"]

[ext_resource type="Shader" path="res://shaders/room_opaque.gdshader" id="room_opaque_shader"]
[ext_resource type="Shader" path="res://shaders/room_glass.gdshader" id="room_glass_shader"]

[sub_resource type="ShaderMaterial" id="Material_balcony"]
shader = ExtResource("room_opaque_shader")
resource_name = "Balcony - nearest filtering"
shader_parameter/surface_texture = ExtResource("2_balcony_texture")
shader_parameter/surface_roughness = 0.86

[sub_resource type="ShaderMaterial" id="Material_frame"]
shader = ExtResource("room_opaque_shader")
resource_name = "Door frame - nearest filtering"
shader_parameter/surface_texture = ExtResource("3_frame_texture")
shader_parameter/surface_roughness = 0.65

[sub_resource type="ShaderMaterial" id="Material_glass"]
shader = ExtResource("room_glass_shader")
resource_name = "Balcony glass"
render_priority = 1
shader_parameter/surface_color = Color(1, 1, 1, 0.1)
shader_parameter/surface_texture = ExtResource("4_glass_texture")
shader_parameter/surface_roughness = 0.16

[sub_resource type="FastNoiseLite" id="Noise_fog"]
noise_type = 1
frequency = 0.012
fractal_octaves = 3

[sub_resource type="NoiseTexture2D" id="Texture_fog"]
width = 256
height = 256
seamless = true
noise = SubResource("Noise_fog")

[sub_resource type="ShaderMaterial" id="Material_sky"]
resource_local_to_scene = true
shader = ExtResource("6_sky")
shader_parameter/fog_noise = SubResource("Texture_fog")

[sub_resource type="ShaderMaterial" id="Material_near_fog"]
resource_local_to_scene = true
shader = ExtResource("7_fog")
shader_parameter/fog_noise = SubResource("Texture_fog")
shader_parameter/opacity = 0.5
shader_parameter/noise_scale = Vector2(4, 2.4)

[sub_resource type="ShaderMaterial" id="Material_far_fog"]
resource_local_to_scene = true
shader = ExtResource("7_fog")
shader_parameter/fog_noise = SubResource("Texture_fog")
shader_parameter/opacity = 0.85
shader_parameter/noise_scale = Vector2(3, 1.6)
shader_parameter/drift = Vector2(-0.005, 0.001)

[sub_resource type="QuadMesh" id="Mesh_sky"]
size = Vector2(14, 10)

[sub_resource type="ShaderMaterial" id="Material_window_haze"]
resource_name = "Faint haze just inside the window"
resource_local_to_scene = true
shader = ExtResource("7_fog")
shader_parameter/fog_noise = SubResource("Texture_fog")
shader_parameter/fog_color = Color(0.1, 0.12, 0.15, 1)
shader_parameter/opacity = 0.12
shader_parameter/noise_scale = Vector2(1.2, 1.6)
shader_parameter/drift = Vector2(0.003, -0.002)

[sub_resource type="QuadMesh" id="Mesh_window_haze"]
size = Vector2(1.65, 2.45)

[sub_resource type="ShaderMaterial" id="Material_close_snow"]
resource_name = "Occasional soft foreground flakes"
shader = ExtResource("8_snow")
shader_parameter/opacity = 0.4
shader_parameter/flutter_distance = 0.1
shader_parameter/edge_softness = 0.5

[sub_resource type="ShaderMaterial" id="Material_near_snow"]
resource_name = "Fluttering snowflakes"
shader = ExtResource("8_snow")
shader_parameter/flutter_distance = 0.16

[sub_resource type="ShaderMaterial" id="Material_distant_snow"]
resource_name = "Fine snow fading into fog"
shader = ExtResource("8_snow")
shader_parameter/opacity = 0.55
shader_parameter/flutter_distance = 0.22

[sub_resource type="QuadMesh" id="Mesh_close_flake"]
material = SubResource("Material_close_snow")
size = Vector2(0.055, 0.055)

[sub_resource type="QuadMesh" id="Mesh_near_flake"]
material = SubResource("Material_near_snow")
size = Vector2(0.04, 0.04)

[sub_resource type="QuadMesh" id="Mesh_distant_flake"]
material = SubResource("Material_distant_snow")
size = Vector2(0.032, 0.032)

[sub_resource type="Gradient" id="Gradient_snow_lifetime"]
