[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/apps/window_art.tscn" id="1_frame"]
[ext_resource type="Script" path="res://scripts/apps/kodukaija_prompt.gd" id="2_prompt"]
[ext_resource type="Texture2D" path="res://assets/sprites/kalev1.png" id="3_kalev"]
[ext_resource type="Script" path="res://scripts/apps/button_feedback.gd" id="4_button"]
[ext_resource type="Material" path="res://resources/button_highlight.tres" id="5_highlight"]
[ext_resource type="Texture2D" path="res://resources/antivirus_logo.tres" id="6_logo"]

[node name="KodukaijaPrompt" instance=ExtResource("1_frame")]
script = ExtResource("2_prompt")

[node name="Title" type="Label" parent="."]
offset_left = 36.0
offset_top = 8.0
offset_right = 620.0
offset_bottom = 42.0
text = "KalevAV"

[node name="AntivirusLogo" type="TextureRect" parent="."]
offset_left = 68.0
offset_top = 198.0
offset_right = 232.0
offset_bottom = 374.0
mouse_filter = 2
texture = ExtResource("6_logo")
expand_mode = 1
stretch_mode = 5

[node name="Kalevipoeg" type="TextureRect" parent="."]
layout_mode = 1
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 18.0
offset_top = -272.0
offset_right = 276.0
offset_bottom = -14.0
grow_vertical = 0
mouse_filter = 2
texture = ExtResource("3_kalev")
expand_mode = 1
stretch_mode = 5
flip_h = true

[node name="Content" type="MarginContainer" parent="."]
offset_left = 294.0
offset_top = 194.0
offset_right = 852.0
offset_bottom = 632.0
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Stack" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Heading" type="Label" parent="Content/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Open Kodukäija.exe?"

[node name="Instructions" type="Label" parent="Content/Stack"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2
size_flags_vertical = 3
text = "Move through the house with WASD or the arrow keys.\n\nIf the screen goes dark, KalevAV will restart this file."
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="Content/Stack"]
layout_mode = 2
theme_override_constants/separation = 18
alignment = 2

[node name="BackButton" type="Button" parent="Content/Stack/Actions"]
material = ExtResource("5_highlight")
custom_minimum_size = Vector2(170, 54)
layout_mode = 2
focus_mode = 0
mouse_default_cursor_shape = 2
script = ExtResource("4_button")
text = "Back"

[node name="RunButton" type="Button" parent="Content/Stack/Actions"]
material = ExtResource("5_highlight")
custom_minimum_size = Vector2(170, 54)
layout_mode = 2
focus_mode = 0
mouse_default_cursor_shape = 2
script = ExtResource("4_button")
text = "Run"

[connection signal="pressed" from="Content/Stack/Actions/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Content/Stack/Actions/RunButton" to="." method="_on_run_pressed"]
