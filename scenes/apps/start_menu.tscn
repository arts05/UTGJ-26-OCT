[connection signal="gui_input" from="DismissArea" to="." method="_on_outside_gui_input"]
[connection signal="pressed" from="MenuPosition/Panel/KalevAV" to="." method="_on_kalevav_pressed"]
[connection signal="pressed" from="MenuPosition/Panel/Settings" to="." method="_on_settings_pressed"]
