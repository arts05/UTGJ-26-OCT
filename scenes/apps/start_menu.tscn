[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/start_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://resources/start_menu_art.tres" id="2_art"]
[ext_resource type="Texture2D" path="res://resources/antivirus_logo.tres" id="3_logo"]
[ext_resource type="Material" path="res://resources/window_shadow.tres" id="4_shadow"]
[ext_resource type="FontVariation" path="res://resources/os_font.tres" id="5_font"]

[sub_resource type="StyleBoxEmpty" id="Style_clear"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="Style_hover"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.18, 0.39, 0.75, 1)

[sub_resource type="StyleBoxFlat" id="Style_pressed"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.12, 0.29, 0.61, 1)

[sub_resource type="Theme" id="Theme_shortcuts"]
default_font = ExtResource("5_font")
default_font_size = 30
Button/colors/font_color = Color(0.08, 0.12, 0.2, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/constants/h_separation = 10
Button/constants/icon_max_width = 32
Button/styles/normal = SubResource("Style_clear")
Button/styles/hover = SubResource("Style_hover")
Button/styles/pressed = SubResource("Style_pressed")
Button/styles/focus = SubResource("Style_clear")

[node name="StartMenu" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("Theme_shortcuts")
script = ExtResource("1_menu")

[node name="DismissArea" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_bottom = -28.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuPosition" type="Control" parent="."]
layout_mode = 1
anchor_top = 1.0
anchor_bottom = 1.0
offset_top = -560.0
offset_right = 420.0
offset_bottom = -28.0
grow_vertical = 0
mouse_filter = 2

[node name="Panel" type="Control" parent="MenuPosition"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Shadow" type="TextureRect" parent="MenuPosition/Panel"]
material = ExtResource("4_shadow")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = -2.0
offset_right = 6.0
offset_bottom = -2.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_art")
expand_mode = 1

[node name="Artwork" type="TextureRect" parent="MenuPosition/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_art")
expand_mode = 1

[node name="KalevAV" type="Button" parent="MenuPosition/Panel"]
layout_mode = 0
