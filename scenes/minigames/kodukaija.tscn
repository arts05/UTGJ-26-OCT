[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/minigames/kodukaija.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/minigames/kodukaija_house.tscn" id="2_house"]
[ext_resource type="Shader" path="res://shaders/house_visibility.gdshader" id="3_visibility"]
[ext_resource type="Theme" path="res://resources/desktop_theme.tres" id="4_theme"]

[sub_resource type="FastNoiseLite" id="Noise_fog"]
noise_type = 1
frequency = 0.025
fractal_octaves = 2

[sub_resource type="NoiseTexture2D" id="Texture_fog"]
width = 128
height = 128
seamless = true
noise = SubResource("Noise_fog")

[sub_resource type="ShaderMaterial" id="Material_darkness"]
resource_local_to_scene = true
shader = ExtResource("3_visibility")
shader_parameter/fog_noise = SubResource("Texture_fog")

[sub_resource type="World2D" id="World_house"]
resource_local_to_scene = true

[node name="Kodukaija" type="Control"]
layout_mode = 3
