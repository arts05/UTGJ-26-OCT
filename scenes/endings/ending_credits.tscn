[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ending_credits.gd" id="1_credits"]
[ext_resource type="Theme" path="res://resources/menu_theme.tres" id="4_theme"]
[ext_resource type="AudioStream" path="res://assets/sounds/tsitsor.ogg" id="6_music"]
[ext_resource type="FontFile" path="res://assets/fonts/tahoma.ttf" id="8_tahoma"]

[sub_resource type="Theme" id="Theme_sources"]
default_font = ExtResource("8_tahoma")
default_font_size = 24
Label/colors/font_color = Color(0.85, 0.88, 0.86, 1)

[node name="EndingCredits" type="CanvasLayer"]
layer = 20
script = ExtResource("1_credits")
editor_description = "The same hard title cut, complete song, and credits for both endings. Adjust card durations here and audio volume on Music."

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_music")
volume_db = -6.0
bus = &"Music"
playback_type = 1
editor_description = "Starts on the title cut. Its finished signal returns to the menu after the entire clip; the last credit card holds until then."

[node name="Black" type="ColorRect" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("4_theme")
color = Color(0, 0, 0, 1)

[node name="Title" type="Label" parent="Black"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("8_tahoma")
theme_override_font_sizes/font_size = 84
text = "Project Kalev"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Team" type="Label" parent="Black"]
visible = false
layout_mode = 1
