[sub_resource type="FastNoiseLite" id="Noise_signal"]
noise_type = 1
frequency = 0.012
fractal_octaves = 3

[sub_resource type="NoiseTexture2D" id="Texture_signal"]
width = 256
height = 256
seamless = true
noise = SubResource("Noise_signal")

[sub_resource type="ShaderMaterial" id="Material_signal"]
resource_local_to_scene = true
shader = ExtResource("2_signal")
shader_parameter/signal_noise = SubResource("Texture_signal")

[sub_resource type="ShaderMaterial" id="Material_selection"]
shader = ExtResource("10_selection")

[sub_resource type="StyleBoxEmpty" id="Style_button"]
content_margin_left = 0.0
content_margin_top = 7.0
