Button/colors/font_hover_color = Color(0.95, 0.96, 0.89, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/styles/normal = SubResource("Style_button")
Button/styles/hover = SubResource("Style_button")
Button/styles/pressed = SubResource("Style_button")
Button/styles/disabled = SubResource("Style_button")
Button/styles/focus = SubResource("Style_button")

